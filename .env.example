PORT=5000
DB_URL=your_mongodb_connection_string
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=your_access_secret
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=your_refresh_secret
JWT_REFRESH_EXPIRES=30d

# BCRYPT
BCRYPT_SALT_ROUND=10

# SUPER ADMIN (created at boot, idempotently)
SUPER_ADMIN_EMAIL=super@example.com
SUPER_ADMIN_PASSWORD=super_admin_password

# Demo seed (npm run seed). Both passwords are required and must be >= 12 chars.
# In production the seed refuses to run unless ALLOW_DEMO_SEED=true, and should
# only be used against a dedicated demo database.
SEED_PASSWORD=replace_with_at_least_12_chars
SEED_ADMIN_PASSWORD=replace_with_at_least_12_chars
ALLOW_DEMO_SEED=false

# Optional: Google OAuth. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CALLBACK_URL=

# Express Session
EXPRESS_SESSION_SECRET=your_express_session_secret

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Optional: OpenRouteService. Booking returns 503 until this is configured.
ORS_API_KEY=

# Optional: SMTP for OTP email. OTP send returns 503 until configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Redis for OTP storage. The API boots without it; OTP returns 503.
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
